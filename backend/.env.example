# QuickRes Agentic AI Backend Environment Configuration

# Primary LLM Provider: groq | gemini | openai | anthropic
LLM_PROVIDER=groq

# Model Selection
# Groq examples: openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant
# Gemini examples: gemini-2.5-flash-lite, gemini-1.5-flash
# OpenAI examples: gpt-4o-mini, gpt-4o
LLM_MODEL=openai/gpt-oss-120b

# Groq API Keys (Primary & Optional Failover Backup)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_backup_groq_api_key_here

# Optional Alternative Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
